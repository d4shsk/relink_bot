TELEGRAM_TOKEN=your-telegram-bot-token-here

# Режим работы relink-бота:
#   maintenance — идут техработы/миграция, ссылки на нового бота не показываются (по умолчанию)
#   live        — переезд завершён, показывается полное сообщение со ссылками
RELINK_MODE=maintenance

# Настройки для автоматической рассылки
DATABASE_URL=postgresql://anywai:password@127.0.0.1:5432/anywai
RELINK_BROADCAST=1
